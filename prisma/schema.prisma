generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id])
  Ticket         Ticket[]

  @@unique([organizationId, name])
}

model Department {
  id             Int          @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Organization   Organization @relation(fields: [organizationId], references: [id])
  User           User[]

  @@unique([organizationId, name])
}

model Organization {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  code        String       @unique
  description String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Category    Category[]
  Department  Department[]
}

model Ticket {
  id                             Int             @id @default(autoincrement())
  ticketNumber                   String          @unique
  title                          String
  description                    String
  categoryId                     Int
  employeeId                     Int
  assignedToId                   Int?
  priority                       Ticket_priority
  status                         Ticket_status   @default(NEW)
  attachment                     String?         @db.LongText

  // ==========================
  // SLA
  // ==========================
  firstResponseTargetHours       Int             @default(2)
  resolutionTargetHours          Int             @default(24)

  firstResponseDueAt             DateTime?
  firstResponseAt                DateTime?

  resolutionDueAt                DateTime?
  resolvedAt                     DateTime?
  // ==========================

  // ==========================
// Resolution
// ==========================
resolutionSummary                String?         @db.LongText

resolutionHours                  Int?

resolutionMinutes                Int?

resolvedById                     Int?

ResolvedBy User? @relation("Ticket_resolvedByIdToUser", fields: [resolvedById], references: [id])
// ==========================


  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  User_Ticket_assignedToIdToUser User?           @relation("Ticket_assignedToIdToUser", fields: [assignedToId], references: [id])
  Category                       Category        @relation(fields: [categoryId], references: [id])
  User_Ticket_employeeIdToUser   User            @relation("Ticket_employeeIdToUser", fields: [employeeId], references: [id])

  TicketHistory                  TicketHistory[]
  Comments                       TicketComment[]

  @@index([assignedToId], map: "Ticket_assignedToId_fkey")
  @@index([categoryId], map: "Ticket_categoryId_fkey")
  @@index([employeeId], map: "Ticket_employeeId_fkey")
  @@index([resolvedById], map: "Ticket_resolvedById_fkey")
}

model TicketHistory {
  id          Int                     @id @default(autoincrement())
  ticketId    Int
  updatedById Int
  remarks     String?
  oldStatus   TicketHistory_oldStatus
  newStatus   TicketHistory_newStatus
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  Ticket      Ticket                  @relation(fields: [ticketId], references: [id])
  User        User                    @relation(fields: [updatedById], references: [id])

  @@index([ticketId], map: "TicketHistory_ticketId_fkey")
  @@index([updatedById], map: "TicketHistory_updatedById_fkey")
}

model TicketComment {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  commentedBy Int
  comment     String   @db.LongText
  createdAt   DateTime @default(now())

  Ticket Ticket @relation(fields: [ticketId], references: [id])
  User   User   @relation(fields: [commentedBy], references: [id])

  @@index([ticketId])
  @@index([commentedBy])
}

model User {
  id                               Int             @id @default(autoincrement())
  employeeId                       String          @unique
  name                             String
  email                            String          @unique
  password                         String
  role                             User_role
  status                           User_status     @default(ACTIVE)
  departmentId                     Int
  createdAt                        DateTime        @default(now())
  updatedAt                        DateTime        @updatedAt
  Ticket_Ticket_assignedToIdToUser Ticket[]        @relation("Ticket_assignedToIdToUser")
  Ticket_Ticket_employeeIdToUser   Ticket[]        @relation("Ticket_employeeIdToUser")
  TicketHistory                    TicketHistory[]
  TicketComments                   TicketComment[]
  Ticket_Ticket_resolvedByIdToUser Ticket[] @relation("Ticket_resolvedByIdToUser")
  Department                       Department      @relation(fields: [departmentId], references: [id])

  @@index([departmentId], map: "User_departmentId_fkey")
}

enum TicketHistory_oldStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
}

enum TicketHistory_newStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
}

enum User_role {
  ADMIN
  IT_SUPPORT
  EMPLOYEE
}

enum User_status {
  ACTIVE
  INACTIVE
}

enum Ticket_priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Ticket_status {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REOPENED
  CLOSED
}
